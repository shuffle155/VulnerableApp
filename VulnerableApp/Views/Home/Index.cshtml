@{
	ViewData["Title"] = "Home Page";
}

<div>
	@foreach (var user in Model)
	{
		<table class="table table-bordered">
			<thead>
				<tr>
					<th>Account</th>
					<th>Email</th>
				</tr>
			</thead>
			<tbody>
				<tr>
					<td>@user.Username</td>
					<td>@user.Email</td>
				</tr>
			</tbody>
		</table>
	}
</div>